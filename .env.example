# Meliora_API - environment template
# Copy to ".env" (which is git-ignored) and fill in real values.
# NEVER commit the real .env. Generate secrets with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"

# ---- Server ----
APP_PORT=7000
NODE_ENV=development
# cookie lifetime used when the login cookie is set (check usermanagement/user.controller.js for the unit)
COOKIE_TIME=

# ---- Main MySQL database (Meliora) ----
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASS=
MYSQL_DB=

# ---- HR database ----
HR_HOST=
HR_DB_USER=
HR_DB_PASS=
HR_SQL=

# ---- PSS database (config/database.js) ----
PSS_HOST=
PSS_DB_USER=
PSS_DB_PASS=
PSS_SQL=

# ---- HSPG database (config/database.js) ----
HSPG_HOST=
HSPG_DB_USER=
HSPG_DB_PASS=
HSPG_SQL=

# ---- Authentication / signing secrets (use a different long random value for each) ----
JWT_KEY=
ACCESS_TOKEN_SECRET=
REFRESH_TOKEN_SECRET=
SECRET_KEY_MEL=
SECRET_ID_MEL=
# secret for the "KMC" Authorization header token (authentication/token_validation.js)
SECRET_ID_KMCMEL=

# ---- Password / data encryption ----
PASSWORD_SECRET=
ENCRYPT_HANDLER_KEY=

# ---- Petty cash ----
# largest amount that can be issued to an employee in one go (optional, default 50000)
PETTY_CASH_MAX_AMOUNT=50000

# ---- Third party services ----
GEMINI_API_KEY=
BITVOICE_API_KEY=

# ---- Email (Indent module) ----
EMAIL_USER=
EMAIL_PASS=

# ---- HTTPS (only if the commented https block in app.js is enabled) ----
SSL_KEY_PATH=
SSL_CERT_PATH=
